# Copy to .env and adjust. .env is git-ignored.

# --- Postgres (docker-compose.yml) ---
POSTGRES_USER=teachers
POSTGRES_PASSWORD=teachers
POSTGRES_DB=teachers
POSTGRES_PORT=5432

# --- Application ---
# Must match the four values above.
DATABASE_URL=postgres://teachers:teachers@localhost:5432/teachers

# better-auth. Generate a secret with: openssl rand -base64 32
# Sign-in fails while this is the placeholder — replace it before `npm run dev`.
BETTER_AUTH_SECRET=replace-me
BETTER_AUTH_URL=http://localhost:3000

# --- Demo seed (npm run db:seed) ---
# The teacher the fixture scenario belongs to. The seed deletes this user and
# everything cascading from them, then re-inserts; it refuses to run with
# NODE_ENV=production unless SEED_ALLOW_PRODUCTION=1.
SEED_USER_EMAIL=demo@teachers.local
SEED_USER_PASSWORD=demo-password-1

# --- Production only (docker-compose.prod.yml) — README "Deploying to the VPS" ---
# The GHCR image to run. GitHub Actions publishes ghcr.io/<owner>/teachers:latest
# on every push to main; pin a :sha-<short-sha> tag instead for a controlled
# rollout or a rollback.
IMAGE=ghcr.io/vasilymarchenko/teachers:latest

# The public hostname. Must resolve to this VPS before `docker compose up` —
# Caddy requests its TLS certificate from Let's Encrypt on first request for it.
CADDY_DOMAIN=teachers.example.com
# Let's Encrypt sends expiry/problem notices here. Required — Caddy's ACME
# client rejects an empty value.
CADDY_EMAIL=you@example.com

# In production, DATABASE_URL and BETTER_AUTH_URL are derived from the
# variables above by docker-compose.prod.yml itself — do not set them here.
